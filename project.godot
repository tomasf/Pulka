; Engine configuration file.

config_version=5

[application]

config/name="Pulka"
config/version="0.1"
config/description="Ett fartfyllt pulkaspel i en oändlig backe."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
config/project_settings_override.pc="user://pulka.window.cfg"
config/project_settings_override.editor_hint=""
boot_splash/bg_color=Color(0.0627451, 0.0745098, 0.16078431, 1)
boot_splash/image="res://boot_splash.png"
boot_splash/stretch_mode=1
boot_splash/use_filter=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/tvos/max_scale=1.0

[rendering]

renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.mobile=0
anti_aliasing/quality/msaa_3d.web=0
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.web=2048
lights_and_shadows/directional_shadow/size.tvos=2048
