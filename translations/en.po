msgstr "Into the rink boards!"

msgid "Utvisning, tio minuter!"
msgstr "Ten-minute penalty!"

msgid "In i granskogen!"
msgstr "Into the spruce forest!"

msgid "Barr överallt."
msgstr "Needles everywhere."

msgid "Skogen tog dig."
msgstr "The forest got you."

msgid "Du handlade lite på vägen."
msgstr "You did some shopping on the way."

msgid "Butiken har stängt. Nu."
msgstr "The shop is closed. Now."

msgid "Vilse i villaområdet!"
msgstr "Lost in the suburbs!"

msgid "Kanelbulle! +%d"
msgstr "Cinnamon bun! +%d"

msgid "Varma vantar, mer fart!"
msgstr "Warm mittens, more speed!"

msgid "Plask!"
msgstr "Splash!"

msgid "Blöta byxor!"
msgstr "Wet trousers!"

msgid "Isvak!"
msgstr "A hole in the ice!"

msgid "För lite fart, för mycket vatten."
msgstr "Too little speed, too much water."

msgid "Du överlevde stupet! +%d"
msgstr "You survived the drop! +%d"

msgid "Takhopp! +50"
msgstr "Rooftop jump! +50"

msgid "Luftfärd! %s s +%d"
msgstr "Airtime! %s s +%d"

msgid "Glömde sätta sig!"
msgstr "Forgot to sit down!"

msgid "Landade mitt i tricket."
msgstr "Landed halfway through the trick."

msgid "Glömde landa först."
msgstr "Forgot to land first."

msgid "Stel som en pinne. Landade som en."
msgstr "Stiff as a plank. Landed like one."

msgid "Granen vann."
msgstr "The spruce won."

msgid "Trädkramare!"
msgstr "Tree hugger!"

msgid "Barr i munnen."
msgstr "A mouthful of needles."

msgid "Granen stod där först."
msgstr "The spruce was there first."

msgid "Stenhårt!"
msgstr "Rock solid!"

msgid "Stenen rörde sig inte en millimeter."
msgstr "The rock didn't budge a millimetre."

msgid "Aj, aj, sten!"
msgstr "Ow, ow, rock!"

msgid "Stubben var där först."
msgstr "The stump was there first."

msgid "Stubbad!"
msgstr "Stumped!"

msgid "Stopp i avloppet!"
msgstr "Blocked drain!"

msgid "Du fastnade i gallret!"
msgstr "You got stuck in the grate!"

msgid "Ispelaren stod stadigt."
msgstr "The ice pillar stood its ground."

msgid "Iskallt möte!"
msgstr "An icy encounter!"

msgid "Containern vann."
msgstr "The container won."

msgid "Du blev fraktgods!"
msgstr "You've been shipped!"

msgid "Skorstenen vann."
msgstr "The chimney won."

msgid "Sotare för en dag!"
msgstr "Chimney sweep for a day!"

msgid "Rakt in i skorstenen!"
msgstr "Straight into the chimney!"

msgid "Ursäkta! Ursäkta!"
msgstr "Excuse me! Excuse me!"

msgid "%s såg dig inte komma."
msgstr "%s didn't see you coming."

msgid "%s tappade termosen!"
msgstr "%s dropped the thermos!"

msgid "%s spillde ut hela kaffet."
msgstr "%s spilled all the coffee."

