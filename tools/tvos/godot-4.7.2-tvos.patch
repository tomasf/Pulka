+void EditorExportPlatformTVOS::initialize() {
+	if (EditorNode::get_singleton()) {
+		EditorExportPlatformAppleEmbedded::_initialize(_tvos_logo_svg, _tvos_run_icon_svg);
+#ifdef MACOS_ENABLED
+		_start_remote_device_poller_thread();
+#endif
+	}
+}
