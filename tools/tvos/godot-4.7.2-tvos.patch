new file mode 100644
index 0000000000..a71e7b63ee
--- /dev/null
+++ b/platform/tvos/SCsub
@@ -0,0 +1,32 @@
+#!/usr/bin/env python
+from misc.utility.scons_hints import *
+
+from platform_tvos_builders import generate_bundle
+
+from platform_methods import combine_libs_apple_embedded
+
+Import("env")
+
+tvos_lib = [
+    "display_layer_tvos.mm",
+    "display_server_tvos.mm",
+    "godot_view_tvos.mm",
+    "main_tvos.mm",
+    "os_tvos.mm",
+]
+
+env_tvos = env.Clone()
+tvos_lib = env_tvos.add_library("tvos", tvos_lib)
+
+# Enable module support
+env_tvos.Append(CCFLAGS=["-fmodules", "-fcxx-modules"])
+
+if "LIBS_EXTERNAL" in env_tvos:
+    env_tvos.Depends(tvos_lib, env_tvos["LIBS_EXTERNAL"])
+
+combine_command = env_tvos.Command(
+    "#bin/libgodot" + env_tvos["LIBSUFFIX"], [tvos_lib] + env_tvos["LIBS"], combine_libs_apple_embedded
+)
+
+if env["generate_bundle"]:
+    env.AlwaysBuild(env.CommandNoCache("generate_bundle", combine_command, env.Run(generate_bundle)))
